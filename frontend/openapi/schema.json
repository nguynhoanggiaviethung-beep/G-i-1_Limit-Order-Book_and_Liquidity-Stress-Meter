  "components": {
    "schemas": {
      "ForecastRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "enum": [
              "BTCUSDT",
              "ETHUSDT"
            ],
            "title": "Symbol",
            "description": "Binance Spot symbol included in the configured study."
          },
          "horizon_days": {
            "type": "integer",
            "enum": [
              1,
              7,
              30
            ],
            "title": "Horizon Days",
            "description": "Direct forecast horizon in UTC days; research design supports 1, 7, or 30.",
            "default": 1
          },
          "model": {
            "type": "string",
            "enum": [
              "random_walk",
              "rolling_mean_7",
              "rolling_mean_30",
              "ewma_094",
              "har",
              "har_log",
              "har_j",
              "har_cj",
              "shar",
              "harq",
              "elasticnet",
              "random_forest",
              "lightgbm_l2",
              "lightgbm_qlike",
              "xgboost",
              "garch_t",
              "gjr_t",
              "egarch_t",
              "garch_skewt"
            ],
            "title": "Model",
            "description": "Volatility model name. Optional models require backend/requirements-optional.txt.",
            "default": "random_walk"
          },
          "mode": {
            "type": "string",
            "enum": [
              "research",
              "production"
            ],
            "title": "Mode",
            "description": "research loads the frozen walk-forward result; production fits a point-in-time model from the latest synchronized local Binance data.",
            "default": "research"
          },
          "confidence_levels": {
            "items": {
              "type": "number",
              "enum": [
                0.95,
                0.975,
                0.99
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Confidence Levels",
            "description": "VaR/ES confidence levels supported by the current risk configuration."
          }
        },
        "type": "object",
        "required": [
          "symbol"
        ],
        "title": "ForecastRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MarketCandle": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "interval": {
            "type": "string",
            "title": "Interval"
          },
          "open_time": {
            "type": "string",
            "format": "date-time",
            "title": "Open Time"
          },
          "close_time": {
            "type": "string",
            "format": "date-time",
            "title": "Close Time"
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "volume": {
            "type": "number",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "interval",
          "open_time",
          "close_time",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "MarketCandle"
      },
      "MarketDataResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "interval": {
            "type": "string",
            "title": "Interval"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          },
          "candles": {
            "items": {
              "$ref": "#/components/schemas/MarketCandle"
            },
            "type": "array",
            "title": "Candles"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "interval",
          "rows",
          "candles"
        ],
        "title": "MarketDataResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
